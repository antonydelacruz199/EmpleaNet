<bpmn:collaboration id="Collab_E3"><bpmn:participant id="Pool_1" name="E3. Toma de decisiones y mejora continua" processRef="Process_E3" /></bpmn:collaboration>
<bpmn:process id="Process_E3" name="E3. Toma de decisiones y mejora continua" isExecutable="false"><bpmn:laneSet id="LaneSet_E3"><bpmn:lane id="Lane_0" name="Comite de mejora continua"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>end1</bpmn:flowNodeRef><bpmn:flowNodeRef>end2</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Inicio"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t1" name="Analisis de indicadores
del sistema"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:task id="t2" name="Identificacion de oportunidades
de mejora"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw1" name="Requiere cambio?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t3" name="Priorizacion de cambios
funcionales y tecnicos"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task><bpmn:task id="t4" name="Aprobacion e implementacion
de acciones de mejora"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end1" name="Fin: mejora aplicada"><bpmn:incoming>Flow_6</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="end2" name="Fin: sin cambios"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="t1" /><bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="t2" /><bpmn:sequenceFlow id="Flow_3" sourceRef="t2" targetRef="gw1" /><bpmn:sequenceFlow id="Flow_4" name="Si" sourceRef="gw1" targetRef="t3" /><bpmn:sequenceFlow id="Flow_5" sourceRef="t3" targetRef="t4" /><bpmn:sequenceFlow id="Flow_6" sourceRef="t4" targetRef="end1" /><bpmn:sequenceFlow id="Flow_7" name="No" sourceRef="gw1" targetRef="end2" /></bpmn:process>
