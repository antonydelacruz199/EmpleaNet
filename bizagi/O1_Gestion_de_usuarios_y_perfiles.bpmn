<bpmn:collaboration id="Collab_O1"><bpmn:participant id="Pool_1" name="O1. Gestion de usuarios y perfiles" processRef="Process_O1" /></bpmn:collaboration>
<bpmn:process id="Process_O1" name="O1. Gestion de usuarios y perfiles" isExecutable="false"><bpmn:laneSet id="LaneSet_O1"><bpmn:lane id="Lane_0" name="Estudiante / Egresado"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Sistema"><bpmn:flowNodeRef>gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Inicio"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t1" name="Registro de estudiantes
