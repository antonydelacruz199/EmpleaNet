                   id="Definitions_O2"
                   targetNamespace="http://bizagi.com/bpmn/O2"
                   exporter="Claude" exporterVersion="1.0">
<bpmn:collaboration id="Collab_O2"><bpmn:participant id="Pool_1" name="O2. Gestion de ofertas laborales y practicas" processRef="Process_O2" /></bpmn:collaboration>
<bpmn:process id="Process_O2" name="O2. Gestion de ofertas laborales y practicas" isExecutable="false"><bpmn:laneSet id="LaneSet_O2"><bpmn:lane id="Lane_0" name="Administrador"><bpmn:flowNodeRef>start1</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Sistema"><bpmn:flowNodeRef>gwm</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>end_no</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="Empresa / Fuente externa"><bpmn:flowNodeRef>start2</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start1" name="Inicio: registro manual"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t1" name="Registro manual
de ofertas"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:startEvent id="start2" name="Inicio: fuente externa"><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t2" name="Importacion o integracion de
ofertas desde fuentes externas"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task><bpmn:parallelGateway id="gwm" name="Union"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:parallelGateway><bpmn:task id="t3" name="Validacion de datos
de la oferta"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw1" name="Oferta valida?"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="end_no" name="Fin: oferta rechazada"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent><bpmn:task id="t4" name="Clasificacion por categoria,
modalidad y ubicacion"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task><bpmn:task id="t5" name="Publicacion
de ofertas"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:task><bpmn:task id="t6" name="Actualizacion y cierre
de ofertas vencidas"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end" name="Fin"><bpmn:incoming>Flow_11</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="start1" targetRef="t1" /><bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="gwm" /><bpmn:sequenceFlow id="Flow_3" sourceRef="start2" targetRef="t2" /><bpmn:sequenceFlow id="Flow_4" sourceRef="t2" targetRef="gwm" /><bpmn:sequenceFlow id="Flow_5" sourceRef="gwm" targetRef="t3" /><bpmn:sequenceFlow id="Flow_6" sourceRef="t3" targetRef="gw1" /><bpmn:sequenceFlow id="Flow_7" name="No" sourceRef="gw1" targetRef="end_no" /><bpmn:sequenceFlow id="Flow_8" name="Si" sourceRef="gw1" targetRef="t4" /><bpmn:sequenceFlow id="Flow_9" sourceRef="t4" targetRef="t5" /><bpmn:sequenceFlow id="Flow_10" sourceRef="t5" targetRef="t6" /><bpmn:sequenceFlow id="Flow_11" sourceRef="t6" targetRef="end" /></bpmn:process>
