<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_E1"
                   targetNamespace="http://bizagi.com/bpmn/E1"
                   exporter="Claude" exporterVersion="1.0">
<bpmn:collaboration id="Collab_E1"><bpmn:participant id="Pool_1" name="E1. Planificacion y gestion del sistema" processRef="Process_E1" /></bpmn:collaboration>
<bpmn:process id="Process_E1" name="E1. Planificacion y gestion del sistema" isExecutable="false"><bpmn:laneSet id="LaneSet_E1"><bpmn:lane id="Lane_0" name="Comite de planificacion / Sistema"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Inicio"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t1" name="Identificacion de necesidades
institucionales y de usuarios"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:task id="t2" name="Definicion de objetivos y
alcance del sistema"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task><bpmn:task id="t3" name="Definicion de politicas de uso y
lineamientos funcionales"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task><bpmn:task id="t4" name="Planificacion de mejoras
del sistema"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end" name="Fin"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="t1" /><bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="t2" /><bpmn:sequenceFlow id="Flow_3" sourceRef="t2" targetRef="t3" /><bpmn:sequenceFlow id="Flow_4" sourceRef="t3" targetRef="t4" /><bpmn:sequenceFlow id="Flow_5" sourceRef="t4" targetRef="end" /></bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_E1"><bpmndi:BPMNPlane id="Plane_E1" bpmnElement="Pool_1"><bpmndi:BPMNShape id="Pool_1_di" bpmnElement="Pool_1" isHorizontal="true"><dc:Bounds x="0" y="0" width="1280" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="30" y="30" width="1250" height="170" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="72" y="97" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="62" y="137" width="56" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="215" y="75" width="130" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="205" y="159" width="150" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="405" y="75" width="130" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="395" y="159" width="150" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="595" y="75" width="130" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="585" y="159" width="150" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="785" y="75" width="130" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="775" y="159" width="150" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="1022" y="97" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1012" y="137" width="56" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="108" y="115" /><di:waypoint x="215" y="115" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="345" y="115" /><di:waypoint x="405" y="115" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="535" y="115" /><di:waypoint x="595" y="115" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="725" y="115" /><di:waypoint x="785" y="115" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="915" y="115" /><di:waypoint x="1022" y="115" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
