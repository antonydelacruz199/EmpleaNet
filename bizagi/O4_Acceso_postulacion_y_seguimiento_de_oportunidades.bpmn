<bpmn:collaboration id="Collab_O4"><bpmn:participant id="Pool_1" name="O4. Acceso, postulacion y seguimiento de oportunidades" processRef="Process_O4" /></bpmn:collaboration>
<bpmn:process id="Process_O4" name="O4. Acceso, postulacion y seguimiento de oportunidades" isExecutable="false"><bpmn:laneSet id="LaneSet_O4"><bpmn:lane id="Lane_0" name="Estudiante / Egresado"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Sistema"><bpmn:flowNodeRef>t_fav</bpmn:flowNodeRef><bpmn:flowNodeRef>end_fav</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>gw2</bpmn:flowNodeRef><bpmn:flowNodeRef>end_no</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Inicio"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t1" name="Visualizacion del detalle
de la oferta"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw1" name="Postular o guardar?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t_fav" name="Gestion de ofertas
favoritas o guardadas"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end_fav" name="Fin: oferta guardada"><bpmn:incoming>Flow_4</bpmn:incoming></bpmn:endEvent><bpmn:task id="t2" name="Verificacion de
requisitos minimos"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw2" name="Cumple requisitos?"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="end_no" name="Fin: no cumple requisitos"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent><bpmn:task id="t3" name="Registro de
postulacion"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task><bpmn:task id="t4" name="Confirmacion de
postulacion"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:task><bpmn:task id="t5" name="Registro del historial
de postulaciones"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task><bpmn:task id="t6" name="Seguimiento del estado
de la oportunidad"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end" name="Fin"><bpmn:incoming>Flow_12</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="t1" /><bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="gw1" /><bpmn:sequenceFlow id="Flow_3" name="Guardar" sourceRef="gw1" targetRef="t_fav" /><bpmn:sequenceFlow id="Flow_4" sourceRef="t_fav" targetRef="end_fav" /><bpmn:sequenceFlow id="Flow_5" name="Postular" sourceRef="gw1" targetRef="t2" /><bpmn:sequenceFlow id="Flow_6" sourceRef="t2" targetRef="gw2" /><bpmn:sequenceFlow id="Flow_7" name="No" sourceRef="gw2" targetRef="end_no" /><bpmn:sequenceFlow id="Flow_8" name="Si" sourceRef="gw2" targetRef="t3" /><bpmn:sequenceFlow id="Flow_9" sourceRef="t3" targetRef="t4" /><bpmn:sequenceFlow id="Flow_10" sourceRef="t4" targetRef="t5" /><bpmn:sequenceFlow id="Flow_11" sourceRef="t5" targetRef="t6" /><bpmn:sequenceFlow id="Flow_12" sourceRef="t6" targetRef="end" /></bpmn:process>
