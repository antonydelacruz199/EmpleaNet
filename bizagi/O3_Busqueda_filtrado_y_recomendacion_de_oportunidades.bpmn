                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_O3"
                   targetNamespace="http://bizagi.com/bpmn/O3"
                   exporter="Claude" exporterVersion="1.0">
<bpmn:collaboration id="Collab_O3"><bpmn:participant id="Pool_1" name="O3. Busqueda, filtrado y recomendacion de oportunidades" processRef="Process_O3" /></bpmn:collaboration>
<bpmn:process id="Process_O3" name="O3. Busqueda, filtrado y recomendacion de oportunidades" isExecutable="false"><bpmn:laneSet id="LaneSet_O3"><bpmn:lane id="Lane_0" name="Estudiante / Egresado"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>t7</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Sistema"><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="Motor de recomendacion"><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Inicio"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t1" name="Consulta de oportunidades
disponibles"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:task id="t2" name="Aplicacion de filtros
de busqueda"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task><bpmn:task id="t3" name="Recuperacion del perfil
del usuario"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task><bpmn:task id="t4" name="Analisis de coincidencia
perfil-oferta"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task><bpmn:task id="t5" name="Generacion de recomendaciones
personalizadas"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task><bpmn:task id="t6" name="Ordenamiento de resultados
por relevancia"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task><bpmn:task id="t7" name="Presentacion de oportunidades
recomendadas"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end" name="Fin"><bpmn:incoming>Flow_8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="t1" /><bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="t2" /><bpmn:sequenceFlow id="Flow_3" sourceRef="t2" targetRef="t3" /><bpmn:sequenceFlow id="Flow_4" sourceRef="t3" targetRef="t4" /><bpmn:sequenceFlow id="Flow_5" sourceRef="t4" targetRef="t5" /><bpmn:sequenceFlow id="Flow_6" sourceRef="t5" targetRef="t6" /><bpmn:sequenceFlow id="Flow_7" sourceRef="t6" targetRef="t7" /><bpmn:sequenceFlow id="Flow_8" sourceRef="t7" targetRef="end" /></bpmn:process>
