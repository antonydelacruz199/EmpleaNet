"130" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="1155" y="329" width="150" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="1355" y="75" width="130" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="1345" y="159" width="150" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="1592" y="97" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1582" y="137" width="56" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="108" y="115" /><di:waypoint x="215" y="115" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="345" y="115" /><di:waypoint x="405" y="115" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="470" y="155" /><di:waypoint x="660" y="245" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="660" y="325" /><di:waypoint x="850" y="415" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="915" y="455" /><di:waypoint x="975" y="455" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1040" y="415" /><di:waypoint x="1230" y="325" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1230" y="245" /><di:waypoint x="1420" y="155" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1485" y="115" /><di:waypoint x="1592" y="115" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
