<bpmn:collaboration id="Collab_S5"><bpmn:participant id="Pool_1" name="S5. Integracion con fuentes externas" processRef="Process_S5" /></bpmn:collaboration>
<bpmn:process id="Process_S5" name="S5. Integracion con fuentes externas" isExecutable="false"><bpmn:laneSet id="LaneSet_S5"><bpmn:lane id="Lane_0" name="Empresa / Fuente externa"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Sistema"><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>end_no</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Inicio"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t1" name="Identificacion de
fuentes de datos"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:task id="t2" name="Conexion con portales
o empresas externas"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task><bpmn:task id="t3" name="Extraccion o recepcion
de informacion"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task><bpmn:task id="t4" name="Validacion del
formato de datos"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw1" name="Formato valido?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="end_no" name="Fin: datos rechazados"><bpmn:incoming>Flow_6</bpmn:incoming></bpmn:endEvent><bpmn:task id="t5" name="Transformacion e
integracion de ofertas"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task><bpmn:task id="t6" name="Sincronizacion de
