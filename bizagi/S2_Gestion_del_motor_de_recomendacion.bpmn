<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_S2"
                   targetNamespace="http://bizagi.com/bpmn/S2"
                   exporter="Claude" exporterVersion="1.0">
<bpmn:collaboration id="Collab_S2"><bpmn:participant id="Pool_1" name="S2. Gestion del motor de recomendacion" processRef="Process_S2" /></bpmn:collaboration>
<bpmn:process id="Process_S2" name="S2. Gestion del motor de recomendacion" isExecutable="false"><bpmn:laneSet id="LaneSet_S2"><bpmn:lane id="Lane_0" name="Sistema"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Inicio"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t1" name="Definicion de reglas
de recomendacion"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:task id="t2" name="Configuracion de parametros
de coincidencia"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task><bpmn:task id="t3" name="Ejecucion del motor
de recomendacion"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task><bpmn:task id="t4" name="Evaluacion del desempeno
del recomendador"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw1" name="Desempeno optimo?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t5" name="Ajuste y optimizacion
del modelo"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end" name="Fin"><bpmn:incoming>Flow_6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="t1" /><bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="t2" /><bpmn:sequenceFlow id="Flow_3" sourceRef="t2" targetRef="t3" /><bpmn:sequenceFlow id="Flow_4" sourceRef="t3" targetRef="t4" /><bpmn:sequenceFlow id="Flow_5" sourceRef="t4" targetRef="gw1" /><bpmn:sequenceFlow id="Flow_6" name="Si" sourceRef="gw1" targetRef="end" /><bpmn:sequenceFlow id="Flow_7" name="No" sourceRef="gw1" targetRef="t5" /><bpmn:sequenceFlow id="Flow_8" sourceRef="t5" targetRef="t3" /></bpmn:process>
