{
  "name": "empleanet",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @empleanet/web dev",
    "dev:api": "pnpm --filter @empleanet/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "smoke": "node scripts/smoke-test.mjs",
    "backup:db": "node -e \"require('child_process').execSync(process.platform==='win32'?'powershell -File scripts/backup-sqlite.ps1':'bash scripts/backup-sqlite.sh',{stdio:'inherit'})\""
  }
}
